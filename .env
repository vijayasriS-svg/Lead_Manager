# Server port (defaults to 3000 in full-stack mode)
PORT=3000

# SQLite database file path (defaults to ./leads.db)
DATABASE_PATH=./leads.db

# Comma-separated allowed CORS origins for standalone frontend/backend mode
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Seed initial sample leads once when leads.db is first created ("true" or "false")
SEED_SAMPLE_DATA=true

# Optional frontend API base URL when running frontend separately from backend (e.g. http://localhost:5000)
VITE_API_BASE_URL=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
